# Copy to `.env` and set a real secret. Never commit `.env`.
MORI_GRPC_TOKEN=change-me-to-a-long-random-secret
# MORI_GRPC_ADDR=0.0.0.0:50051

# Google OAuth browser leg (optional). By default Mori launches a local
# Chrome/Edge with its own profile (data/chrome-profile) and drives one tab
# over CDP. Point these at a browser you run yourself when needed:
# MORI_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# MORI_BROWSER_PROFILE=data/chrome-profile
#
# External CloakBrowser manager (optional). Used only when it is reachable;
# otherwise Mori falls back to the local browser.
# CLOAKBROWSER_CDP_HTTP=http://host.docker.internal:8080/api/profiles/<profile-id>/cdp
# CLOAKBROWSER_WS_HOST=

# ── VSProxy Auto-Rolling Configuration ──────────────────────────────
# Masukkan API Key dari vsproxy.org (dimulai dengan vk_...)
VSPROXY_API_KEY=

# Optional: subuser_id atau invoice. Jika dikosongkan, sistem akan otomatis
# mengekstrak subuser dari username proxy yang sedang aktif pada bot.
# VSPROXY_SUBUSER_ID=
VSPROXY_INVOICE=

# Target negara (default: us)
VSPROXY_COUNTRY=us

# Mode proxy (sticky / rotating, default: sticky)
VSPROXY_MODE=sticky

# Interval rotasi dasar dalam menit (1-120, default: 45)
VSPROXY_ROTATION=45

# High-anonymity IPs only (true / false, default: true)
VSPROXY_ANON=true

# Jumlah maksimal percobaan reconnect gagal sebelum rolling proxy (default: 3)
VSPROXY_MAX_RETRIES=3

# Aktifkan rolling otomatis saat reconnect gagal atau IP limit / HTTP 403 (true / false)
AUTO_ROTATE_RECONNECT=true
VSPROXY_AUTO_ROLL=true

# Cooldown minimal sebelum boleh rolling proxy lagi dalam detik (default: 65)
VSPROXY_COOLDOWN_SECS=65
