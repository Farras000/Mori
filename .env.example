# Copy to `.env` and set a real secret. Never commit `.env`.
MORI_GRPC_TOKEN=change-me-to-a-long-random-secret
# MORI_GRPC_ADDR=0.0.0.0:50051

# Google OAuth browser leg (optional). CloakBrowser manager runs outside this
# compose stack — point at its profile CDP base URL. Empty = manual
# callback/token endpoints only.
# CLOAKBROWSER_CDP_HTTP=http://host.docker.internal:8080/api/profiles/<profile-id>/cdp
# CLOAKBROWSER_WS_HOST=
